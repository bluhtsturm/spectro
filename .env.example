# Host-Ordner, die in der Weboberflaeche durchsuchbar sein sollen.
# Beliebig viele - jeder braucht unten einen passenden volume-Eintrag.
MUSIC_DIR=/srv/nas/musik
RIPS_DIR=/srv/nas/vinyl-rips

# Beschriftung und Reihenfolge im Auswahlmenue (Label=Pfad-im-Container)
MEDIA_DIRS=Musik=/media/musik:Vinyl-Rips=/media/rips

# Port auf dem Host
PORT=8080

# Welches Image und welche Fassung verwendet werden soll. Fuer einen eigenen
# Fork den GitHub-Namen anpassen, oder in docker-compose.yml auf "build: ."
# umstellen, um aus dem Quelltext zu bauen.
IMAGE=ghcr.io/bluhtsturm/spectro
TAG=latest

# Groessenlimit je Upload (MB) und Obergrenze des PNG-Caches (MB)
MAX_UPLOAD_MB=1024
CACHE_MAX_MB=2048

# Parallele Renderjobs (Standard: halbe CPU-Anzahl)
MAX_RENDERS=2

# Gleichzeitig gepruefte Dateien aller laufenden Scans zusammen
# (Standard: wie MAX_RENDERS)
SCAN_JOBS=2

# Gleichzeitige Wiedergaben (Standard: doppelt MAX_RENDERS, mindestens 4)
MAX_STREAMS=4

# Optionale HTTP-Basic-Absicherung - beide leer lassen zum Deaktivieren.
# Ist nur eines gesetzt, gilt die Anmeldung trotzdem (mit leerem Gegenstueck).
AUTH_USER=
AUTH_PASS=

# 1 = auch Dateien ohne bekannte Audio-Endung auflisten
SHOW_ALL_FILES=0

# Ergebnisablage: 1 = Scan-Ergebnisse behalten, damit beim naechsten Lauf nur
# geaenderte Dateien neu gerechnet werden (liegt im Volume unter /data/index)
SIDECAR=1

# Sprache der Oberflaeche und der Bewertungen, wenn der Browser nichts vorgibt
LANG_DEFAULT=de
